# ============================================================
# 非敏感变量（真实值，可入库）
# 敏感变量一律不放这里：见 secrets/*.enc 与 secrets/README.md
# ============================================================

# 服务器公网 IP（客户端与订阅产物使用）
SERVER_IP=173.242.113.39

# 端口
HYSTERIA_PORT=38475
XRAY_PORT=443
SUB_SERVER_PORT=8080

# Hysteria 证书路径（新运行路径；真实部署时从 /etc/hysteria 复制过来）
HYSTERIA_CERT=/etc/proxy/hysteria/server.crt
HYSTERIA_KEY=/etc/proxy/hysteria/server.key

# Hysteria 伪装站与 SNI（SNI 需与证书 CN 一致）
MASQUERADE_URL=https://bing.com
HYSTERIA_TLS_SNI=bing.com

# Reality 目标站（固定 IPv4；避开 www.microsoft.com，见 docs/architecture.md）
REALITY_DEST=142.251.15.91:443
REALITY_SERVER_NAME=dl.google.com
REALITY_FLOW=xtls-rprx-vision
CLIENT_FINGERPRINT=chrome

# 订阅服务基础 URL（不含 token；token 见 secrets/SUB_TOKEN.enc）
SUB_BASE_URL=http://173.242.113.39:8080

# ============================================================
# 敏感变量清单（值由 decrypt-secrets.sh 从 secrets/*.enc 解密注入，
# 禁止在此处填写明文）
#   HYSTERIA_AUTH_PASSWORD   Hysteria auth.password（与订阅产物同源）
#   XRAY_UUID                VLESS 客户端 UUID
#   XRAY_PRIVATE_KEY         Reality 服务端私钥（公钥 pbk 由脚本推导，不单独存放）
#   XRAY_SHORT_ID            Reality shortIds[0]
#   SUB_TOKEN                订阅目录名 / token（http.server 唯一防线）
# ============================================================
